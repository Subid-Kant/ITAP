# ══════════════════════════════════════════════════════════
#  ITAP v2.0 — Environment Configuration Template
#  Copy this to .env and fill in your values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────
# Development (SQLite — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./itap.db

# Production (PostgreSQL — recommended for MNC/LE deployment):
# DATABASE_URL=postgresql+asyncpg://itap_user:STRONG_PASS@localhost:5432/itap_db

# ── Security ─────────────────────────────────────────────
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64_CHAR_RANDOM_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Built-in user passwords (change these!)
ADMIN_PASSWORD=ITAP@Admin2025!
ANALYST_PASSWORD=ITAP@Analyst2025!
VIEWER_PASSWORD=ITAP@Viewer2025!

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# ── OSINT API Keys (Optional — demo mode works without) ──
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
ALIENVAULT_OTX_KEY=
NVD_API_KEY=              # Optional: higher rate limits for NVD

# ── Email Alerting (Optional) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=itap-alerts@yourorg.com
SMTP_FROM_NAME=ITAP Security Platform
SMTP_USE_TLS=True
ALERT_TO_EMAILS=soc@yourorg.com,ciso@yourorg.com

# ── Webhook Alerting (Optional) ──────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...
WEBHOOK_URLS=https://your-siem.com/api/alerts

# ══════════════════════════════════════════════════════════
#  PRODUCTION DEPLOYMENT CHECKLIST
#  ✅ SECRET_KEY set to 64+ char random string
#  ✅ DEBUG=False
#  ✅ ENVIRONMENT=production
#  ✅ ALLOWED_ORIGINS set to actual frontend domain(s)
#  ✅ All user passwords changed from defaults
#  ✅ DATABASE_URL points to PostgreSQL with SSL
#  ✅ SMTP configured for real alert delivery
#  ✅ API keys for OSINT sources configured
#  ✅ TLS/HTTPS enabled via reverse proxy (nginx/caddy)
#  ✅ Firewall restricts port 8000 to reverse proxy only
# ══════════════════════════════════════════════════════════
